<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net$([System.Version]::Parse('$(NETCoreSdkVersion)').Major).0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <StartupObject>McpServer</StartupObject>
    <AssemblyName>coordinator-mcp</AssemblyName>
    <Version>0.2.3</Version>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
  </PropertyGroup>
  <ItemGroup>
    <!-- The package's model code answers reads without the Editor. It and Newtonsoft.Json work by reflection, so the
         trimmer keeps them whole. -->
    <ProjectReference Include="../CoordinatorCore/CoordinatorCore.csproj" />
    <TrimmerRootAssembly Include="CoordinatorCore" />
    <TrimmerRootAssembly Include="Newtonsoft.Json" />
  </ItemGroup>
</Project>
